{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "instructions": ["AGENTS.md"],
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "mcp": {
    "wiki-alegra": {
      "type": "remote",
      "url": "https://wiki.alegra.com/mcp",
      "oauth": {}
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    },
    "Linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "google-calendar": {
      "type": "remote",
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "{env:GOOGLE_MCP_CLIENT_ID}",
        "clientSecret": "{env:GOOGLE_MCP_CLIENT_SECRET}",
        "scope": "https://www.googleapis.com/auth/calendar.calendarlist.readonly https://www.googleapis.com/auth/calendar.events.readonly https://www.googleapis.com/auth/calendar.events.freebusy"
      }
    },
    "google-chat": {
      "type": "remote",
      "url": "https://chatmcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "{env:GOOGLE_MCP_CLIENT_ID}",
        "clientSecret": "{env:GOOGLE_MCP_CLIENT_SECRET}",
        "scope": "https://www.googleapis.com/auth/chat.spaces.readonly https://www.googleapis.com/auth/chat.memberships.readonly https://www.googleapis.com/auth/chat.messages.readonly https://www.googleapis.com/auth/chat.users.readstate.readonly"
      }
    },
    "navi": {
      "type": "remote",
      "url": "https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-east-1%3A664923676010%3Aruntime%2FBrain2Mcp_Brain2Mcp-kkINiIBm2p/invocations?qualifier=DEFAULT",
      "oauth": {
        "clientId": "628v0gm42b0ackm37s08vj641t",
        "scope": "openid email profile",
        "redirectUri": "http://localhost:8080/callback"
      },
      "enabled": true
    },
    "meet-wiki": {
      "type": "http",
      "url": "https://meet-wiki.alegra.com/api/mcp"
    }
  }
}
